pipeline {
    agent { 
        node {
            label 'docker-agent-python'
            }
      }
    triggers {
        pollSCM '* * * * *'
    }
    stages {
        stage('Build') {
            steps {
                echo "---Building---"
                sh '''
                cd app
                '''
            }
        }
        stage('Test') {
            steps {
                echo "---Testing---"
                sh '''
                cd app
                python3 hello.py
                python3 hello.py nithin
                '''
            }
        }
        stage('Deliver') {
            steps {
                echo '---Deliver---'
                sh '''
                echo "Delivery is going on.."
                '''
            }
        }
    }
}